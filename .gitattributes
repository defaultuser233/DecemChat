# Normalize line endings for text files
* text=auto

# Ensure source files use LF in repository
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.lock text eol=lf

# Windows scripts may keep CRLF if needed
*.bat text eol=crlf
*.ps1 text eol=crlf

# Android 的 gradlew 是 shell 脚本，必须保持 LF——
# 这条是预防性的：本机 core.autocrlf=true，将来在 Windows 上重新生成工程时别把 CRLF 带进去
src-tauri/gen/android/gradlew text eol=lf

# Binary assets must not be line-ending converted
*.ttf binary
*.jpg binary
*.png binary
